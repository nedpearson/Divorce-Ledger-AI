# Railway Environment Variables Configuration
# Copy these to your Railway project's Variables section

# ============================================
# CRITICAL - Application won't start without these
# ============================================

# Database connection to Supabase (REQUIRED)
# Format: postgresql://user:password@host:port/database?sslmode=require
# IMPORTANT: Must include ?sslmode=require for Supabase
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Session encryption secret (REQUIRED)
# Generate with: openssl rand -base64 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<GENERATE_RANDOM_32_CHAR_STRING>

# Node environment (REQUIRED for production)
NODE_ENV=production

# ============================================
# IMPORTANT - Core features require these
# ============================================

# Application mode: live, demo, or development
APP_MODE=live

# Public base URL for webhooks and callbacks
# Railway will auto-assign, but set this for webhooks to work
# Format: https://your-app-name.up.railway.app
BASE_URL=https://your-railway-app.up.railway.app

# Stripe integration (REQUIRED for billing features)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_MODE=production
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid email service (REQUIRED for transactional emails)
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@divorceledger.live

# ============================================
# AI FEATURES - Optional but recommended
# ============================================

# OpenAI for document analysis
OPENAI_API_KEY=sk-...

# Anthropic Claude for document scanning
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini AI
GEMINI_API_KEY=...

# Document analysis model (defaults to gpt-4o if not set)
DOCUMENT_ANALYSIS_MODEL=gpt-4o

# ============================================
# APPWRITE FILE STORAGE - Required if accepting file uploads
# ============================================

# Appwrite cloud or self-hosted endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite project ID (create at appwrite.io)
APPWRITE_PROJECT_ID=...

# Appwrite API key with Database + Storage permissions
APPWRITE_API_KEY=...

# ============================================
# SMS & 2FA - Optional
# ============================================

TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ============================================
# QUICKBOOKS INTEGRATION - Optional
# ============================================

QB_CLIENT_ID=...
QB_CLIENT_SECRET=...
QB_REDIRECT_URI=https://your-railway-app.up.railway.app/api/quickbooks/callback

# ============================================
# FIREFLY III INTEGRATION - Optional
# ============================================

FIREFLY_ACCESS_TOKEN=...
FIREFLY_URL=...

# ============================================
# ADMIN & SECURITY
# ============================================

# Admin API authentication
ADMIN_SECRET=<GENERATE_RANDOM_STRING>

# Demo mode reset authorization (if using demo mode)
DEMO_RESET_KEY=<GENERATE_RANDOM_STRING>

# Remember me cookie encryption
REMEMBER_ME_SECRET=<GENERATE_RANDOM_STRING>

# ============================================
# CRON & SCHEDULING - Optional
# ============================================

# Enable scheduled tasks (billing, quotas, etc.)
CRON_ENABLED=true

# Cron admin endpoints authentication
CRON_ADMIN_SECRET=<EXISTING_VALUE_FROM_RAILWAY>

# ============================================
# RAILWAY-SPECIFIC (Auto-populated by Railway)
# ============================================

# Railway automatically sets these - do not manually configure:
# PORT - Auto-assigned by Railway
# RAILWAY_ENVIRONMENT - Set by Railway (production, staging, etc.)
# RAILWAY_PUBLIC_DOMAIN - Your app's public domain
# RAILWAY_STATIC_URL - Your app's static URL
# RAILWAY_PROJECT_ID - Your Railway project ID
# RAILWAY_SERVICE_ID - Your Railway service ID

# ============================================
# NOTES
# ============================================

# 1. SESSION_SECRET Generation:
#    Run: openssl rand -base64 32
#    Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 2. Database Migrations:
#    Migrations run automatically on deployment when DATABASE_URL is set
#    Check Railway logs for: "[STARTUP] Database migrations completed successfully"
#
# 3. File Uploads:
#    Railway uses ephemeral filesystem - files won't persist between deploys
#    MUST configure Appwrite for file storage or uploads will fail
#
# 4. Email Service:
#    Application now uses direct SENDGRID_API_KEY (not Replit connectors)
#    If SendGrid not configured, emails will fail but app continues
#
# 5. WebSocket CORS:
#    Automatically includes Railway domains - no manual CORS configuration needed
#
# 6. Health Check:
#    Railway will ping /api/health endpoint
#    Returns 200 OK when database connected
#
# 7. Stripe Webhooks:
#    After deployment, update Stripe webhook URL to:
#    https://your-railway-app.up.railway.app/api/stripe/webhook
#
# 8. First Deploy:
#    - Cold start takes 30-60 seconds due to migrations
#    - Check logs for successful migration: "✅ [STARTUP] Database migrations completed"
#    - Verify tables in Supabase: users, billing_records, violation_records, etc.
