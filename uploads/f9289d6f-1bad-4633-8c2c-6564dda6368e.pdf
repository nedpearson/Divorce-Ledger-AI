            </div></span><span id="j_id0:pageStatus.stop"></span></span><span id="j_id0:outerPanel">
                <center><iframe id="pdf" style="position:fixed; top:0; left:0; bottom:0; right:0; width:100%; height:100%; border:none; margin:0; padding:0; overflow:hidden; z-index:999999;"></iframe></center></span>
    
    
    <script type="text/javascript">
    window.onload = function () {
        var base64String = "";
        if(base64String)
        {
            const byteCharacters = atob(base64String);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }    
            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], {type: 'application/pdf'});
            
                if(window.navigator && window.navigator.msSaveOrOpenBlob){
                    window.navigator.msSaveOrOpenBlob(blob,'document.pdf');
                }else{ 
                    // document.getElementById('pdf').setAttribute('src',"data:application/pdf;base64,");
                       document.getElementById('pdf').setAttribute('src',URL.createObjectURL(blob)); 
                } 
            
            var isShowPrint = false;
            if(isShowPrint == false){
                let filename = "EBill" + Math.random().toString(36).substring(8);
                  let otrofile = filename.replace(/[0-9]/g, '');
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = otrofile;
                document.body.append(link);
                link.click();
            }
            else if(isShowPrint == true){
                setTimeout(function(){
                    let objFra = document.getElementById('pdf');
                    objFra.contentWindow.focus();
                    objFra.contentWindow.print();
                },100);
            } 
        }
        else {
            document.getElementById('pdf').setAttribute('src','Error: document not found');
        }
       
    }
    </script></body></html>