# =============================================================================
# DIVORCE LEDGER AI - ENVIRONMENT CONFIGURATION
# =============================================================================

NODE_ENV=development
APP_MODE=development

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Super Admin Account (created at first startup)
# ⚠️  CHANGE THESE IN PRODUCTION! Default values are for development only.
SUPERADMIN_EMAIL=nedpearson@gmail.com
SUPERADMIN_PASSWORD=1Pearson2

# One-time bootstrap secret for protected /api/bootstrap/run endpoint
# Generate a strong random value and keep it server-side only
BOOTSTRAP_SECRET=change-this-bootstrap-secret

# Demo Mode Configuration
DEMO_MODE=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123

# Session Secret (REQUIRED) - Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Admin operations secret
ADMIN_SECRET=change-this-admin-secret-in-production

# Remember Me Token Secret (optional, defaults to SESSION_SECRET)
REMEMBER_ME_SECRET=change-this-remember-me-secret

# =============================================================================
# DATABASE (SUPABASE POSTGRESQL)
# =============================================================================

# Supabase Project Settings → Database
# Pooler URL (for most connections)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct URL (for migrations and admin operations)
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Individual PostgreSQL connection params (optional, for compatibility)
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.PROJECT_REF
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=postgres

# =============================================================================
# SUPABASE (Optional - only if using Supabase Auth/Storage/Functions)
# =============================================================================

# Project Settings → API → Project URL
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Project Settings → API → anon/public key (safe for browser)
SUPABASE_ANON_KEY=your-anon-key-here

# Project Settings → API → service_role key (SERVER-SIDE ONLY, never expose to browser!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Standardized Supabase deployment variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_API_URL=https://PROJECT_REF.supabase.co
# (already present) SUPABASE_URL=https://PROJECT_REF.supabase.co
# (already present) VITE_PUBLIC_URL=https://PROJECT_REF.supabase.co
# Use NEXT_PUBLIC_SUPABASE_API_URL everywhere for frontend API calls
# Use SUPABASE_URL for backend and service role
# Use VITE_PUBLIC_URL for QR codes and public links
# -----------------------------------------------------------------------------

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

PORT=5000
VITE_PUBLIC_URL=http://localhost:5000

# =============================================================================
# LLM CONFIGURATION FOR DOCUMENT ANALYSIS
# =============================================================================

# Choose your preferred LLM model for document scanning and categorization
# Options: claude | gpt-4o | gpt-4o-mini | gemini-2.0-flash | gemini-1.5-flash
# DEFAULT: claude (Claude 3.5 Sonnet - RECOMMENDED for financial/legal documents)
DOCUMENT_ANALYSIS_MODEL=claude

# -----------------------------------------------------------------------------
# ANTHROPIC (CLAUDE) API KEY - RECOMMENDED for best accuracy
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# OPENAI API KEY - Alternative option (excellent for vision/OCR)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-placeholder-set-real-key-to-enable-ai
AI_INTEGRATIONS_OPENAI_API_KEY=sk-placeholder-set-real-key-to-enable-ai

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API KEY - Cost-effective option
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# SENTRY ERROR LOGGING (Frontend & Backend)
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# -----------------------------------------------------------------------------

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Stripe (for subscription billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# Twilio (for SMS 2FA)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (for email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Appwrite (for document storage and analysis)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key

# Firefly III (for financial integration)
FIREFLY_ACCESS_TOKEN=your-firefly-access-token

# QuickBooks (for accounting integration)
QB_CLIENT_ID=your-quickbooks-client-id
QB_CLIENT_SECRET=your-quickbooks-client-secret

# Cron scheduler
CRON_ADMIN_SECRET=your-cron-admin-secret

# =============================================================================
# GOOGLE INTEGRATIONS (OPTIONAL)
# =============================================================================

# Google Authentication (OAuth / OpenID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
