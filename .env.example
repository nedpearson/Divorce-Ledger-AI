# =============================================================================
# LLM CONFIGURATION FOR DOCUMENT ANALYSIS
# =============================================================================

# Choose your preferred LLM model for document scanning and categorization
# Options: claude | gpt-4o | gpt-4o-mini | gemini-2.0-flash | gemini-1.5-flash
# DEFAULT: claude (Claude 3.5 Sonnet - RECOMMENDED for financial/legal documents)
DOCUMENT_ANALYSIS_MODEL=claude

# -----------------------------------------------------------------------------
# ANTHROPIC (CLAUDE) API KEY - RECOMMENDED for best accuracy
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# OPENAI API KEY - Alternative option (excellent for vision/OCR)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API KEY - Cost-effective option
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# REPLIT AI INTEGRATIONS (Optional - for Replit deployments)
# -----------------------------------------------------------------------------
# These are set automatically by Replit AI Integrations
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=auto-set-by-replit
# AI_INTEGRATIONS_OPENAI_API_KEY=auto-set-by-replit
# AI_INTEGRATIONS_OPENAI_BASE_URL=auto-set-by-replit
# AI_INTEGRATIONS_GEMINI_API_KEY=auto-set-by-replit
# AI_INTEGRATIONS_GEMINI_BASE_URL=auto-set-by-replit

# =============================================================================
# OTHER ENVIRONMENT VARIABLES (existing configuration)
# =============================================================================

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key

# ... (rest of your existing environment variables)
